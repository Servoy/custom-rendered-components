{
  "name": "customrenderedcomponents",
  "version": "2026.9.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "build_debug": "ng build --watch",
    "make_release": "ng build --configuration production && node scripts/build.js",
    "test": "ng test --no-watch",
    "test:coverage": "ng test --no-watch --coverage --coverage-reporters text-summary --coverage-reporters json-summary --coverage-reporters lcov --coverage-reporters cobertura --coverage-include \"projects/customrenderedcomponents/src/**/*.ts\" --coverage-exclude \"**/*.spec.ts\" --coverage-exclude \"**/*.d.ts\" --coverage-exclude \"**/testingutils.ts\" --coverage-exclude \"**/public-api.ts\"",
    "coverage:summary": "node scripts/coverage-summary.js",
    "test:watch": "ng test",
    "test:ui": "ng test --ui",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.1.2",
    "@angular/cdk": "22.1.2",
    "@angular/common": "22.1.2",
    "@angular/core": "22.1.2",
    "@angular/forms": "22.1.2",
    "@servoy/public": "2026.9.2",
    "rxjs": "7.8.2",
    "sortablejs": "1.15.7",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.4",
    "@angular/cli": "22.1.4",
    "@angular/compiler": "22.1.2",
    "@angular/compiler-cli": "22.1.2",
    "@angular/localize": "22.1.2",
    "@angular/platform-browser": "22.1.2",
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.7.4",
    "@types/sortablejs": "1.15.9",
    "@vitest/coverage-v8": "^4.1.10",
    "adm-zip": "0.6.0",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.8.1",
    "eslint-plugin-only-warn": "1.2.1",
    "jsdom": "^30.0.1",
    "ng-packagr": "22.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
